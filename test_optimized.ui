             <property name="styleSheet">
              <string notr="true">QTabWidget::pane {
    border: 1px solid #3D3F51;
    background-color: #27293D;
    top: -1px; /* 让边框与标签栏无缝连接 */
}

/* 设置页签栏的背景 */
QTabBar::tab {
    background: #1E1E2F;
    color: #8B8B8B;
    padding: 8px 20px;
    border: 1px solid #3D3F51;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

/* 选中页签时的样式（高亮显示） */
QTabBar::tab:selected {
    background: #27293D;
    color: #3498DB; /* 科技蓝 */
    border-bottom: 2px solid #3498DB; /* 底部高亮条 */
    font-weight: bold;
}

/* 鼠标悬停在页签上的样式 */
QTabBar::tab:hover:!selected {
    background: #34495E;
    color: white;
}</string>
